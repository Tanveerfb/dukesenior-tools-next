rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if true; // Public profiles
      allow write: if isOwner(userId);
    }
    
    // Usernames collection (for username uniqueness)
    match /usernames/{username} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    // Friend Requests
    match /friendRequests/{requestId} {
      allow read: if isSignedIn() && 
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if isSignedIn() && 
        request.resource.data.from == request.auth.uid;
      allow update: if isSignedIn() && 
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow delete: if isSignedIn() && 
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
    
    // Friends collection
    match /friends/{friendshipId} {
      allow read: if isSignedIn() && 
        (resource.data.uid1 == request.auth.uid || resource.data.uid2 == request.auth.uid);
      // Write operations should be done server-side or via transactions in the app
      // Users can create/delete their own friendships through the client
      allow create: if isSignedIn() && 
        (request.resource.data.uid1 == request.auth.uid || request.resource.data.uid2 == request.auth.uid);
      allow delete: if isSignedIn() && 
        (resource.data.uid1 == request.auth.uid || resource.data.uid2 == request.auth.uid);
    }
    
    // Blocked Users subcollection
    match /blockedUsers/{uid}/blocked/{blockedUID} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
    
    // Direct Messaging - Thread collection
    match /directMessages/threads/{threadId} {
      // Helper to check if user is a participant in the thread
      function isParticipant() {
        return isSignedIn() && 
          (request.auth.uid in resource.data.participants);
      }
      
      function isParticipantCreate() {
        return isSignedIn() && 
          (request.auth.uid in request.resource.data.participants);
      }
      
      allow read: if isParticipant();
      allow create: if isParticipantCreate();
      allow update: if isParticipant();
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn() && 
          (request.auth.uid in get(/databases/$(database)/documents/directMessages/threads/$(threadId)).data.participants);
        allow create: if isSignedIn() && 
          request.resource.data.from == request.auth.uid &&
          (request.auth.uid in get(/databases/$(database)/documents/directMessages/threads/$(threadId)).data.participants);
        allow update: if isSignedIn() && 
          (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
        allow delete: if isSignedIn() && resource.data.from == request.auth.uid;
      }
    }
    
    // Direct Messaging - Typing indicators
    match /directMessages/typing/{threadId}/users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
