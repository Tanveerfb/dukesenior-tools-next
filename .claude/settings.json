{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{const j=JSON.parse(d);const f=(j.tool_input||{}).file_path||'';if(/\\.(ts|tsx)$/.test(f)){require('child_process').spawnSync('npx',['eslint','--fix',f],{stdio:'inherit',shell:true})}})\" 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "ESLint fixing..."
          }
        ]
      }
    ]
  }
}
